@@ -0,0 +1,9 @@
+package nebula
+
+// CABlocklist returns the fingerprints the CA pool in use refuses, sorted.
+// A reload that cannot load the CA (pki.ca unreadable, no valid CA in it)
+// keeps the old pool and only logs, so the pki.blocklist of a config
+// reloaded in place may not be in force; this says what is.
+func (c *Control) CABlocklist() []string {
+	return c.f.pki.GetCAPool().Blocklist()
+}
