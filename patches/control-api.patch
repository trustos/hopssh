+// AddAdvertiseAddr adds a dynamically-discovered public endpoint (e.g. a
+// UPnP/NAT-PMP port mapping on the home router) to the set of addresses
+// we advertise to the lighthouse. Safe for concurrent use. De-dupes.
+// The next SendUpdate tick (default 10 s) propagates to peers.
+//
+// Added by hopssh patch 11.
+func (lh *LightHouse) AddAdvertiseAddr(addr netip.AddrPort) {
+	if !addr.IsValid() {
+		return
+	}
+	for {
+		cur := lh.advertiseAddrs.Load()
+		for _, a := range *cur {
+			if a == addr {
+				return
+			}
+		}
+		next := make([]netip.AddrPort, 0, len(*cur)+1)
+		next = append(next, *cur...)
+		next = append(next, addr)
+		if lh.advertiseAddrs.CompareAndSwap(cur, &next) {
+			lh.l.Info("lighthouse: added dynamic advertise_addr", "addr", addr)
+			return
+		}
+	}
+}
+
+// RemoveAdvertiseAddr is the inverse of AddAdvertiseAddr. No-op if the
+// address isn't present.
+//
+// Added by hopssh patch 11.
+func (lh *LightHouse) RemoveAdvertiseAddr(addr netip.AddrPort) {
+	for {
+		cur := lh.advertiseAddrs.Load()
+		next := make([]netip.AddrPort, 0, len(*cur))
+		changed := false
+		for _, a := range *cur {
+			if a == addr {
+				changed = true
+				continue
+			}
+			next = append(next, a)
+		}
+		if !changed {
+			return
+		}
+		if lh.advertiseAddrs.CompareAndSwap(cur, &next) {
+			lh.l.Info("lighthouse: removed dynamic advertise_addr", "addr", addr)
+			return
+		}
+	}
+}
+
+// AddStaticHostMap adds runtime-discovered endpoints for a peer's vpnAddr
+// into the lighthouse's cache, making them immediately available for the
+// handshake manager to try. Used by hopssh to inject peer endpoints learned
+// via the HTTPS control-plane heartbeat response when the UDP lighthouse
+// path is unreachable (carrier-filtered cellular to Oracle Cloud, etc).
+// Marks the entry as static so it's not evicted by idle GC. De-dupes.
+//
+// Added by hopssh patch 20.
+func (lh *LightHouse) AddStaticHostMap(vpnAddr netip.Addr, addrs []netip.AddrPort) {
+	if !vpnAddr.IsValid() || len(addrs) == 0 {
+		return
+	}
+	rl := lh.QueryCache([]netip.Addr{vpnAddr})
+	if rl == nil {
+		return
+	}
+	for _, a := range addrs {
+		if !a.IsValid() {
+			continue
+		}
+		rl.LearnRemote(vpnAddr, a)
+	}
+	// Mark as static to prevent GC of this entry (static_host_map semantics).
+	for {
+		cur := lh.staticList.Load()
+		if cur == nil {
+			newMap := make(map[netip.Addr]struct{})
+			newMap[vpnAddr] = struct{}{}
+			if lh.staticList.CompareAndSwap(cur, &newMap) {
+				break
+			}
+			continue
+		}
+		if _, ok := (*cur)[vpnAddr]; ok {
+			break
+		}
+		next := make(map[netip.Addr]struct{}, len(*cur)+1)
+		for k := range *cur {
+			next[k] = struct{}{}
+		}
+		next[vpnAddr] = struct{}{}
+		if lh.staticList.CompareAndSwap(cur, &next) {
+			break
+		}
+	}
+	lh.l.Info("lighthouse: added static host map entry", "vpnAddr", vpnAddr, "addrs", addrs)
+}
+
+// ReplaceStaticHostMap is the replace-not-add cousin of AddStaticHostMap.
+// Both populate the same lighthouse cache for vpnAddr, but ReplaceStaticHostMap
+// FULLY REPLACES the prior reported address set instead of adding to it.
+// Stale entries from previous heartbeats are pruned atomically.
+//
+// Why this exists: Phase G server-pushed peerEndpoints reflect the LATEST
+// known set as of the requesting heartbeat. AddStaticHostMap (which routes
+// through LearnRemote — a singular learned slot per peer) cannot evict an
+// older Reported entry that's no longer in the current set. Over time,
+// stale NAT-PMP-mapped addresses accumulate in the lighthouse's RemoteList
+// reported slice, and Nebula's handshake manager probes all of them.
+// When the upstream router reuses external port numbers across hosts
+// (standard CGNAT behavior), packets sent to a stale address arrive at
+// the WRONG host, generating "Invalid certificate from host" log spam
+// and dead-tunnel cycles.
+//
+// Replace semantics fix this: each heartbeat's peerEndpoints is the
+// authoritative current set; older entries vanish.
+//
+// Added by hopssh patch 21.
+func (lh *LightHouse) ReplaceStaticHostMap(vpnAddr netip.Addr, addrs []netip.AddrPort) {
+	if !vpnAddr.IsValid() || len(addrs) == 0 {
+		return
+	}
+	rl := lh.QueryCache([]netip.Addr{vpnAddr})
+	if rl == nil {
+		return
+	}
+	v4 := make([]*V4AddrPort, 0, len(addrs))
+	v6 := make([]*V6AddrPort, 0, len(addrs))
+	for _, a := range addrs {
+		if !a.IsValid() {
+			continue
+		}
+		if a.Addr().Is4() {
+			v4 = append(v4, netAddrToProtoV4AddrPort(a.Addr(), a.Port()))
+		} else {
+			v6 = append(v6, netAddrToProtoV6AddrPort(a.Addr(), a.Port()))
+		}
+	}
+	rl.Lock()
+	if len(v4) > 0 {
+		rl.unlockedSetV4(vpnAddr, vpnAddr, v4, lh.unlockedShouldAddV4)
+	} else if c := rl.unlockedGetOrMakeV4(vpnAddr); c != nil {
+		c.reported = c.reported[:0]
+		rl.shouldRebuild = true
+	}
+	if len(v6) > 0 {
+		rl.unlockedSetV6(vpnAddr, vpnAddr, v6, lh.unlockedShouldAddV6)
+	} else if c := rl.unlockedGetOrMakeV6(vpnAddr); c != nil {
+		c.reported = c.reported[:0]
+		rl.shouldRebuild = true
+	}
+	rl.Unlock()
+	for {
+		cur := lh.staticList.Load()
+		if cur == nil {
+			newMap := make(map[netip.Addr]struct{})
+			newMap[vpnAddr] = struct{}{}
+			if lh.staticList.CompareAndSwap(cur, &newMap) {
+				break
+			}
+			continue
+		}
+		if _, ok := (*cur)[vpnAddr]; ok {
+			break
+		}
+		next := make(map[netip.Addr]struct{}, len(*cur)+1)
+		for k := range *cur {
+			next[k] = struct{}{}
+		}
+		next[vpnAddr] = struct{}{}
+		if lh.staticList.CompareAndSwap(cur, &next) {
+			break
+		}
+	}
+	lh.l.Info("lighthouse: replaced static host map entry", "vpnAddr", vpnAddr, "addrs", addrs)
+}
+
 func (lh *LightHouse) GetRelaysForMe() []netip.Addr {
 	return *lh.relaysForMe.Load()
 }
