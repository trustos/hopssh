+// BeginBatch makes WriteTo leave packets queued until EndBatch, so a batch of
+// packets costs one syscall. Scopes may overlap between goroutines.
+func (u *StdConn) BeginBatch() {
+	u.sendMu.Lock()
+	u.batches++
+	u.sendMu.Unlock()
+}
+
+// EndBatch closes a BeginBatch scope and sends whatever is queued.
+func (u *StdConn) EndBatch() error {
+	u.sendMu.Lock()
+	defer u.sendMu.Unlock()
+	u.batches--
+	return u.flushLocked()
+}
