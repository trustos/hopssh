+// TestWriteToBatchFlush verifies that WriteTo queues packets and Flush sends
+// them all in a single sendmsg_x syscall. Uses a logger so the StdConn is valid
+// for production-path flush errors.
+func TestWriteToBatchFlush(t *testing.T) {
+	// Sender socket (will queue packets via WriteTo + Flush)
+	sendFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(sendFd)
+
+	senderSA := &unix.SockaddrInet4{Port: 0}
+	senderSA.Addr = [4]byte{127, 0, 0, 1}
+	if err := unix.Bind(sendFd, senderSA); err != nil {
+		t.Fatal(err)
+	}
+
+	// Receiver socket
+	recvFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(recvFd)
+
+	recvSA := &unix.SockaddrInet4{Port: 0}
+	recvSA.Addr = [4]byte{127, 0, 0, 1}
+	if err := unix.Bind(recvFd, recvSA); err != nil {
+		t.Fatal(err)
+	}
+
+	recvBound, err := unix.Getsockname(recvFd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recvAddr := recvBound.(*unix.SockaddrInet4)
+	recvPort := uint16(recvAddr.Port)
+
+	c := newTestStdConn(sendFd)
+
+	dest := netip.AddrPortFrom(netip.AddrFrom4([4]byte{127, 0, 0, 1}), recvPort)
+
+	// Queue 5 small packets — all go to interactive lane (len < 200).
+	// Use Message type (0x01) so we exercise the size-based classification path.
+	c.BeginBatch()
+	for i := 0; i < 5; i++ {
+		if err := c.WriteTo([]byte{0x01, byte(i)}, dest); err != nil {
+			t.Fatalf("WriteTo #%d failed: %v", i, err)
+		}
+	}
+	if got := c.totalQueued(); got != 5 {
+		t.Fatalf("expected 5 queued packets before Flush, got %d", got)
+	}
+	// Type 0x01 (Message) → data lane
+	if got := len(c.laneData); got != 5 {
+		t.Fatalf("expected 5 in data lane, got %d", got)
+	}
+
+	// Flush — should send all 5 in one sendmsg_x
+	if err := c.Flush(); err != nil {
+		t.Fatalf("Flush failed: %v", err)
+	}
+	if got := c.totalQueued(); got != 0 {
+		t.Fatalf("queue should be empty after Flush, got %d", got)
+	}
+
+	// Receive and verify (order preserved within a lane)
+	buf := make([]byte, 1024)
+	for i := 0; i < 5; i++ {
+		n, _, err := unix.Recvfrom(recvFd, buf, 0)
+		if err != nil {
+			t.Fatalf("Recvfrom #%d: %v", i, err)
+		}
+		if n != 2 || buf[0] != 0x01 || buf[1] != byte(i) {
+			t.Errorf("packet %d = %v, want [0x01 %d]", i, buf[:n], i)
+		}
+	}
+
+	// Flushing empty queue is a no-op
+	if err := c.Flush(); err != nil {
+		t.Fatalf("empty Flush failed: %v", err)
+	}
+}
