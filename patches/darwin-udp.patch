diff --git a/github.com/slackhq/nebula/udp/flush.go b/github.com/slackhq/nebula/udp/flush.go
new file mode 100644
index 0000000..428e701
--- /dev/null
+++ b/github.com/slackhq/nebula/udp/flush.go
@@ -0,0 +1,15 @@
+package udp
+
+// hopssh: on macOS WriteTo queues packets inside a batch (see udp_darwin.go).
+// A Conn that does so implements flusher; all others send at once.
+type flusher interface {
+	Flush() error
+}
+
+// Flush sends what WriteTo has queued, if c queues at all.
+func Flush(c Conn) error {
+	if f, ok := c.(flusher); ok {
+		return f.Flush()
+	}
+	return nil
+}
diff --git a/github.com/slackhq/nebula/udp/qos_hint_darwin.go b/github.com/slackhq/nebula/udp/qos_hint_darwin.go
