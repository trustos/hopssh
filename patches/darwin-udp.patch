+		{"test", []byte{0x14}, 0},
+		{"closetunnel", []byte{0x15}, 0},
+		{"control-msg", make1byteN(0x16, 2000), 0},
+		{"version-bits-ignored", []byte{0xf1}, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := classify(tc.pkt); got != tc.want {
+				t.Errorf("classify(%s, len=%d) = %d, want %d", tc.name, len(tc.pkt), got, tc.want)
+			}
+		})
+	}
+}
+
+func make1byteN(first byte, n int) []byte {
+	b := make([]byte, n)
+	b[0] = first
+	return b
+}
+
+// TestPriorityOrder verifies control packets land before data packets in the
+// sendmsg_x batch, and data packets within the data lane preserve FIFO order.
+func TestPriorityOrder(t *testing.T) {
+	sendFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(sendFd)
+	if err := unix.Bind(sendFd, &unix.SockaddrInet4{Port: 0, Addr: [4]byte{127, 0, 0, 1}}); err != nil {
+		t.Fatal(err)
+	}
+
+	recvFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(recvFd)
+	if err := unix.Bind(recvFd, &unix.SockaddrInet4{Port: 0, Addr: [4]byte{127, 0, 0, 1}}); err != nil {
+		t.Fatal(err)
+	}
+	got, err := unix.Getsockname(recvFd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recvPort := uint16(got.(*unix.SockaddrInet4).Port)
+
+	c := newTestStdConn(sendFd)
+	dest := netip.AddrPortFrom(netip.AddrFrom4([4]byte{127, 0, 0, 1}), recvPort)
+
+	// Order: data1, data2, control. After Flush, expect: control, data1, data2.
+	data1 := make1byteN(0x11, 1300)
+	data1[1] = 0xD1
+	data2 := make1byteN(0x11, 1300)
+	data2[1] = 0xD2
+	controlPkt := []byte{0x10, 0xC0}
+
+	c.BeginBatch()
+	if err := c.WriteTo(data1, dest); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.WriteTo(data2, dest); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.WriteTo(controlPkt, dest); err != nil {
+		t.Fatal(err)
+	}
+
+	if len(c.laneControl) != 1 {
+		t.Errorf("control lane: got %d, want 1", len(c.laneControl))
+	}
+	if len(c.laneData) != 2 {
+		t.Errorf("data lane: got %d, want 2", len(c.laneData))
+	}
+
+	if err := c.Flush(); err != nil {
+		t.Fatal(err)
+	}
+
+	// Expect: control (0xC0), then data1 (0xD1), then data2 (0xD2)
+	wantOrder := []byte{0xC0, 0xD1, 0xD2}
+	buf := make([]byte, 2048)
+	for i, want := range wantOrder {
+		n, _, err := unix.Recvfrom(recvFd, buf, 0)
+		if err != nil {
+			t.Fatalf("Recvfrom #%d: %v", i, err)
+		}
+		if n < 2 || buf[1] != want {
+			t.Errorf("packet %d marker = 0x%02x (n=%d), want 0x%02x", i, buf[1], n, want)
+		}
+	}
+}
+
+// TestLaneOverflowIndependence verifies that filling the data lane to capacity
+// triggers flush-and-retry without losing packets.
+func TestLaneOverflowIndependence(t *testing.T) {
+	sendFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(sendFd)
+	if err := unix.Bind(sendFd, &unix.SockaddrInet4{Port: 0, Addr: [4]byte{127, 0, 0, 1}}); err != nil {
+		t.Fatal(err)
+	}
+
+	recvFd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(recvFd)
+	if err := unix.Bind(recvFd, &unix.SockaddrInet4{Port: 0, Addr: [4]byte{127, 0, 0, 1}}); err != nil {
+		t.Fatal(err)
+	}
+	got, err := unix.Getsockname(recvFd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recvPort := uint16(got.(*unix.SockaddrInet4).Port)
+
+	c := newTestStdConn(sendFd)
+	dest := netip.AddrPortFrom(netip.AddrFrom4([4]byte{127, 0, 0, 1}), recvPort)
+
+	// Fill data lane to capacity
+	c.BeginBatch()
+	dataPkt := make1byteN(0x11, 1300)
+	for i := 0; i < laneCapData; i++ {
+		if err := c.WriteTo(dataPkt, dest); err != nil {
+			t.Fatalf("data WriteTo #%d: %v", i, err)
+		}
+	}
+	if len(c.laneData) != laneCapData {
+		t.Fatalf("data lane: got %d, want %d", len(c.laneData), laneCapData)
+	}
+
+	// One more should trigger flush-and-retry
+	if err := c.WriteTo(dataPkt, dest); err != nil {
+		t.Fatalf("overflow WriteTo: %v", err)
+	}
+
+	if len(c.laneData) != 1 {
+		t.Errorf("after overflow: data lane got %d, want 1", len(c.laneData))
+	}
+
+	// Drain any pending packets
+	if err := c.Flush(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// udpPair returns a bound sender StdConn, a bound receiver with a read
+// timeout, and the receiver's address.
+func udpPair(t *testing.T) (*StdConn, int, netip.AddrPort) {
+	t.Helper()
+	var fds [2]int
+	var port uint16
+	for i := range fds {
+		fd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { unix.Close(fd) })
+		sa := &unix.SockaddrInet4{}
+		if i == 1 {
+			sa.Addr = [4]byte{127, 0, 0, 1}
+		}
+		if err := unix.Bind(fd, sa); err != nil {
+			t.Fatal(err)
+		}
+		got, err := unix.Getsockname(fd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		port = uint16(got.(*unix.SockaddrInet4).Port)
+		fds[i] = fd
+	}
+	if err := unix.SetNonblock(fds[0], true); err != nil {
+		t.Fatal(err)
+	}
+	if err := unix.SetsockoptTimeval(fds[1], unix.SOL_SOCKET, unix.SO_RCVTIMEO, &unix.Timeval{Usec: 200000}); err != nil {
+		t.Fatal(err)
+	}
+	return newTestStdConn(fds[0]), fds[1], netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), port)
+}
+
+// received returns the last byte of every packet waiting at fd.
+func received(fd int) string {
+	var got []byte
+	buf := make([]byte, 64)
+	for {
+		n, _, err := unix.Recvfrom(fd, buf, 0)
+		if err != nil || n < 1 {
+			return string(got)
+		}
+		got = append(got, buf[n-1])
+	}
+}
+
+// TestWriteToOutsideBatchSendsNow: punches, lighthouse updates, tunnel tests
+// and the userspace TUN's packets are written outside any batch, and nobody
+// flushes for them.
+func TestWriteToOutsideBatchSendsNow(t *testing.T) {
+	c, recv, dest := udpPair(t)
+	if err := c.WriteTo([]byte("a"), dest); err != nil {
+		t.Fatal(err)
+	}
+	if got := received(recv); got != "a" {
+		t.Errorf("received %q without a Flush, want %q", got, "a")
+	}
+
+	// Overlapping scopes: the queue goes out when either ends.
+	c.BeginBatch()
+	c.BeginBatch()
+	c.WriteTo([]byte("b"), dest)
+	if got := received(recv); got != "" {
+		t.Errorf("received %q inside a batch, want nothing yet", got)
+	}
+	c.EndBatch()
+	if got := received(recv); got != "b" {
+		t.Errorf("received %q after the first EndBatch, want %q", got, "b")
+	}
+	c.WriteTo([]byte("c"), dest)
+	if got := received(recv); got != "" {
+		t.Errorf("received %q with one batch still open, want nothing yet", got)
+	}
+	c.EndBatch()
+	c.WriteTo([]byte("d"), dest)
+	if got := received(recv); got != "cd" {
+		t.Errorf("received %q, want %q", got, "cd")
+	}
+}
+
+// TestRefusedDestinationDoesNotDropOthers: a packet the kernel refuses must
+// neither take the rest of its batch with it nor make it send twice.
+func TestRefusedDestinationDoesNotDropOthers(t *testing.T) {
+	bad := netip.MustParseAddrPort("255.255.255.255:9") // not a broadcast socket
+	for _, order := range []string{"xabc", "axbc", "abcx", "xaxbxc", "abxxc"} {
+		c, recv, dest := udpPair(t)
+		c.BeginBatch()
+		for _, b := range []byte(order) {
+			to := dest
+			if b == 'x' {
+				to = bad
+			}
+			if err := c.WriteTo([]byte{0x01, b}, to); err != nil { // 0x01: all in one lane
+				t.Fatal(err)
+			}
+		}
+		if err := c.EndBatch(); err == nil {
+			t.Errorf("%s: EndBatch reported no error", order)
+		}
+		if got := received(recv); got != "abc" {
+			t.Errorf("%s: received %q, want %q", order, got, "abc")
+		}
+	}
+}
+
+// TestWriteToAfterClose: the fd number may already belong to somebody else.
+func TestWriteToAfterClose(t *testing.T) {
+	_, recv, dest := udpPair(t)
+	fd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := newTestStdConn(fd)
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	reused, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, unix.IPPROTO_UDP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(reused)
+	if reused != fd {
+		t.Skipf("fd %d was not reused (got %d)", fd, reused)
+	}
+	if err := c.WriteTo([]byte("x"), dest); err != net.ErrClosed {
+		t.Errorf("WriteTo after Close = %v, want net.ErrClosed", err)
+	}
+	if got := received(recv); got != "" {
+		t.Errorf("received %q through somebody else's socket", got)
+	}
+}
diff --git a/github.com/slackhq/nebula/udp/udp_darwin_listenout_pipeline_test.go b/github.com/slackhq/nebula/udp/udp_darwin_listenout_pipeline_test.go
new file mode 100644
index 0000000..639928b
--- /dev/null
+++ b/github.com/slackhq/nebula/udp/udp_darwin_listenout_pipeline_test.go
@@ -0,0 +1,253 @@
+//go:build darwin && !e2e_testing
+// +build darwin,!e2e_testing
+
+package udp
+
+import (
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+)
+
+// These tests cover the channel-discipline invariants of the
+// listenOut pipeline introduced in vendor patch 17 (symmetric to
+// patch 12's listenIn pipeline). They do NOT instantiate a full
+// *StdConn — that requires an open UDP socket and a bound IP. Instead
+// they exercise the outBatch slot lifecycle and the channel patterns
+// the real ListenOut / listenOutWorker rely on.
+//
+// Invariants under test:
+//   1. listenOutPipelineSlots slots can be pre-allocated and pushed
+//      onto a buffered channel of cap=listenOutPipelineSlots BEFORE
+//      a consumer goroutine exists. Regression-protects the same
+//      class of bug we hit in v0.10.10-dev1 on the inbound pipeline
+//      (cap=1 with numSlots=2 silently stalled the reader).
+//   2. Slots flow FIFO from reader → worker → reader through the two
+//      channels, preserving inbound batch order. TCP retransmits if
+//      reordered.
+//   3. close(inflight) terminates the worker's `for batch := range`
+//      loop and the worker drains any in-flight slots before exiting.
+//   4. Back-pressure: when both channels are full (worker stalled),
+//      reader blocks rather than allocating more slots or dropping
+//      batches.
+
+const testListenOutBatchSize = 32
+
+func makeTestOutBatch() *outBatch {
+	msgs := make([]msghdrX, testListenOutBatchSize)
+	buffers := make([][]byte, testListenOutBatchSize)
+	names := make([][]byte, testListenOutBatchSize)
+	for i := range msgs {
+		buffers[i] = make([]byte, MTU)
+		names[i] = make([]byte, 28) // SizeofSockaddrInet6
+	}
+	return &outBatch{msgs: msgs, buffers: buffers, names: names}
+}
+
+// TestOutBatchInitDoesNotDeadlock — regression guard. The init loop
+// in ListenOut pushes listenOutPipelineSlots slots onto `free` before
+// the worker exists. If `free` is sized < listenOutPipelineSlots the
+// second push blocks forever waiting for a reader, the agent goes
+// silent on inbound, and only the heartbeat HTTPS channel keeps
+// working — exactly the "online but unreachable" failure mode we
+// already learned about on the outbound side.
+func TestOutBatchInitDoesNotDeadlock(t *testing.T) {
+	free := make(chan *outBatch, listenOutPipelineSlots)
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for k := 0; k < listenOutPipelineSlots; k++ {
+			free <- makeTestOutBatch()
+		}
+	}()
+
+	select {
+	case <-done:
+		// expected
+	case <-time.After(100 * time.Millisecond):
+		t.Fatalf("init loop deadlocked pushing %d slots onto chan of cap %d "+
+			"(would silently stall ListenOut — same class of bug as the v0.10.10-dev1 inbound regression)",
+			listenOutPipelineSlots, cap(free))
+	}
+
+	if got := len(free); got != listenOutPipelineSlots {
+		t.Fatalf("free channel should hold %d slots after init, got %d", listenOutPipelineSlots, got)
+	}
+}
+
+// TestOutBatchPipelineFIFO — slots round-trip from reader → worker
+// → reader in FIFO order. We model the pipeline with a worker stub
+// that records the batch IDs it observes; reader pushes batches with
+// ascending IDs; assert the worker observed them in order.
+//
+// Per-packet ordering INSIDE a batch is preserved by the worker's
+// `for i := 0; i < slot.n; i++` loop (deterministic array iteration);
+// per-batch ordering is preserved by the FIFO Go channel.
+func TestOutBatchPipelineFIFO(t *testing.T) {
+	const numBatches = 64
+
+	inflight := make(chan *outBatch, listenOutPipelineSlots)
+	free := make(chan *outBatch, listenOutPipelineSlots)
+
+	for k := 0; k < listenOutPipelineSlots; k++ {
+		free <- makeTestOutBatch()
+	}
+
+	var observedMu sync.Mutex
+	observed := make([]int, 0, numBatches)
+
+	workerDone := make(chan struct{})
+	go func() {
+		defer close(workerDone)
+		for batch := range inflight {
+			id := int(batch.buffers[0][0])<<8 | int(batch.buffers[0][1])
+			observedMu.Lock()
+			observed = append(observed, id)
+			observedMu.Unlock()
+			free <- batch
+		}
+	}()
+
+	for seq := 0; seq < numBatches; seq++ {
+		batch := <-free
+		batch.n = 1
+		batch.buffers[0][0] = byte(seq >> 8)
+		batch.buffers[0][1] = byte(seq & 0xff)
+		inflight <- batch
+	}
+	close(inflight)
+	<-workerDone
+
+	if got := len(observed); got != numBatches {
+		t.Fatalf("worker observed %d batches, want %d", got, numBatches)
+	}
+	for i, id := range observed {
+		if id != i {
+			t.Fatalf("FIFO violation at index %d: observed id=%d, want %d (full sequence: %v)",
+				i, id, i, observed)
+		}
+	}
+}
+
+// TestOutBatchWorkerShutdownDrainsInflight — closing inflight
+// (which the reader does on EOF / socket-closed) must let the
+// worker drain remaining queued slots before exiting via the
+// natural `for ... range` terminate path. No leaked goroutines, no
+// stuck slots.
+func TestOutBatchWorkerShutdownDrainsInflight(t *testing.T) {
+	inflight := make(chan *outBatch, listenOutPipelineSlots)
+	free := make(chan *outBatch, listenOutPipelineSlots)
+
+	for k := 0; k < listenOutPipelineSlots; k++ {
+		free <- makeTestOutBatch()
+	}
+
+	processed := 0
+	workerDone := make(chan struct{})
+	go func() {
+		defer close(workerDone)
+		for batch := range inflight {
+			processed++
+			free <- batch
+		}
+	}()
+
+	for k := 0; k < listenOutPipelineSlots; k++ {
+		batch := <-free
+		batch.n = 1
+		inflight <- batch
+	}
+	close(inflight)
+
+	select {
+	case <-workerDone:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatalf("worker did not exit within 500ms after close(inflight)")
+	}
+
+	if processed != listenOutPipelineSlots {
+		t.Fatalf("worker processed %d batches before exit, want %d (drain-on-close violated)",
+			processed, listenOutPipelineSlots)
+	}
+
+	if got := len(free); got != listenOutPipelineSlots {
+		t.Fatalf("free channel holds %d slots after worker exit, want %d (slot leak)",
+			got, listenOutPipelineSlots)
+	}
+}
+
+// TestOutBatchBackPressureBlocksReader — when the worker is stalled
+// (we simulate by never reading inflight), the reader must block on
+// <-free rather than allocating more memory or dropping batches.
+// This is what prevents unbounded queueing when the receive rate
+// outpaces decrypt+TUN-write throughput.
+func TestOutBatchBackPressureBlocksReader(t *testing.T) {
+	inflight := make(chan *outBatch, listenOutPipelineSlots)
+	free := make(chan *outBatch, listenOutPipelineSlots)
+
+	for k := 0; k < listenOutPipelineSlots; k++ {
+		free <- makeTestOutBatch()
+	}
+
+	// Fill inflight to capacity — worker NOT consuming.
+	for k := 0; k < listenOutPipelineSlots; k++ {
+		batch := <-free
+		batch.n = 1
+		inflight <- batch
+	}
+
+	// Reader's next attempt is `<-free`; free is empty so it must
+	// block. Don't run actual ReadMulti here — we're testing the
+	// channel arithmetic, not the syscall.
+	blocked := make(chan struct{})
+	go func() {
+		<-free
+		close(blocked)
+	}()
+
+	select {
+	case <-blocked:
+		t.Fatalf("reader did not block when free channel was empty — back-pressure broken")
+	case <-time.After(50 * time.Millisecond):
+		// expected
+	}
+
+	// Drain one slot from inflight and return it to free, simulating
+	// the worker finishing a batch.
+	<-inflight
+	free <- makeTestOutBatch()
+
+	select {
+	case <-blocked:
+		// expected — reader unblocked once a slot returned to free
+	case <-time.After(100 * time.Millisecond):
+		t.Fatalf("reader did not unblock after a slot was returned to free")
+	}
+}
+
+// TestListenOutPipelineSlots_Sane — the slot count is a deliberate
+// design choice: 2 is enough to overlap reader-block with
+// worker-process. Higher would just add latency under back-pressure
+// without further throughput gain. Guard against an accidental
+// future change to 1 (which would reintroduce the original
+// single-goroutine serialization) or to a large number (which would
+// cause buffer-bloat under sustained ingress).
+func TestListenOutPipelineSlots_Sane(t *testing.T) {
+	if listenOutPipelineSlots < 2 {
+		t.Fatalf("listenOutPipelineSlots = %d; pipeline needs ≥ 2 slots to overlap reader-block with worker-process",
+			listenOutPipelineSlots)
+	}
+	if listenOutPipelineSlots > 8 {
+		t.Fatalf("listenOutPipelineSlots = %d; > 8 risks buffer-bloat under sustained ingress (memory: numSlots × batch × MTU)",
+			listenOutPipelineSlots)
+	}
+}
+
+// _unusedKeepImports keeps the netip import live even if a future
+// refactor removes the only direct usage from this file. The test
+// helpers don't currently call netip but the production pipeline
+// does (via the worker reading addr from names[i]); the test file
+// historically had reasons to use it.
+var _unusedKeepImports = netip.AddrPort{}
