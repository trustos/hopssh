diff --git a/github.com/slackhq/nebula/path_question.go b/github.com/slackhq/nebula/path_question.go
new file mode 100644
index 0000000..71cdac5
--- /dev/null
+++ b/github.com/slackhq/nebula/path_question.go
@@ -0,0 +1,53 @@
+package nebula
+
+import (
+	"net/netip"
+
+	"github.com/slackhq/nebula/header"
+)
+
+// hopssh patch 35: a packet that comes from an address says nothing about the way
+// back. Nebula sent to that address all the same: whoever was asked there by
+// TryPromoteBest moved before it answered, and the first copy of a handshake set
+// the path. A path that works in one direction only, as behind a firewall or a
+// strict router, cut the connection each time.
+//
+// So a question is answered where it was asked, and moves nobody. The answer moves
+// whoever asked, and what that one sends then moves the other, by the usual rules.
+
+// pathQuestion is what a TestRequest about another path carries. An agent without
+// this patch takes it for an ordinary one.
+const pathQuestion = "path"
+
+func (f *Interface) ask(h *HostInfo, remote netip.AddrPort) {
+	f.sendTo(header.Test, header.TestRequest, h.ConnectionState, h, remote, []byte(pathQuestion), make([]byte, 12), make([]byte, mtu))
+}
+
+func (f *Interface) answer(h *HostInfo, via ViaSender, nb, out []byte) {
+	if f.lightHouse.GetRemoteAllowList().AllowAll(h.vpnAddrs, via.UdpAddr.Addr()) {
+		f.sendTo(header.Test, header.TestReply, h.ConnectionState, h, via.UdpAddr, []byte(pathQuestion), nb, out)
+	}
+}
+
+// startWhereHeard is for the first packet on a tunnel that the other side has asked
+// for. That one sends where it got the answer to its handshake from, so it hears us
+// there.
+func (f *Interface) startWhereHeard(h *HostInfo, via ViaSender) {
+	if h.ConnectionState.initiator || h.inDirect.Load()+h.inRelayed.Load() > 0 {
+		return
+	}
+	was := h.GetRemote()
+	switch {
+	case !was.IsValid():
+		return
+	case via.IsRelayed:
+		h.relayState.InsertRelayTo(via.relayHI.vpnAddrs[0])
+		h.remote.Store(nil)
+	case via.UdpAddr != was && f.lightHouse.GetRemoteAllowList().AllowAll(h.vpnAddrs, via.UdpAddr.Addr()):
+		h.SetRemote(via.UdpAddr)
+	default:
+		return
+	}
+	h.logger(f.l).Info("Host hears us elsewhere", "udpAddr", was, "from", via)
+	f.ask(h, was)
+}
