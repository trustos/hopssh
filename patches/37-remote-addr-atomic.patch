@@ -0,0 +1,37 @@
+package nebula
+
+import (
+	"net/netip"
+	"sync"
+	"testing"
+)
+
+// hopssh patch 37: the address we send to is changed by the goroutine that receives,
+// and read by the one that sends and by Control (status, the path loop). It was a
+// plain field. Run with -race: without the patch this test fails every time.
+func TestHostInfoRemoteIsSafeToRead(t *testing.T) {
+	vpn := netip.MustParseAddr("10.0.0.2")
+	a := netip.MustParseAddrPort("192.0.2.1:4242")
+	b := netip.MustParseAddrPort("[2001:db8::1]:4243")
+	h := &HostInfo{vpnAddrs: []netip.Addr{vpn}, remotes: NewRemoteList([]netip.Addr{vpn}, nil)}
+	h.SetRemote(a)
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := range 20000 {
+			if i%2 == 0 {
+				h.SetRemote(b)
+			} else {
+				h.SetRemote(a)
+			}
+		}
+	}()
+	for range 20000 {
+		if got := copyHostInfo(h, nil).CurrentRemote; got != a && got != b {
+			t.Fatalf("read %s, which was never set", got)
+		}
+	}
+	wg.Wait()
+}
