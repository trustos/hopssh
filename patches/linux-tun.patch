+++ b/github.com/slackhq/nebula/overlay/tun_linux.go
@@ -35,6 +35,44 @@ type tunFile struct {
 	readPoll   [2]unix.PollFd
 	writePoll  [2]unix.PollFd
 	closed     bool
+	waiters    *tunWaiters // hopssh: shared like shutdownFd, see tun.Close
+}
+
+// tunWaiters counts the goroutines that wait in poll on a tun descriptor
+// (hopssh). The kernel keeps the device until the last of them has left, so
+// Close waits for them: whoever closes a network and opens it again at once,
+// as a certificate renewal does, would otherwise find the device busy.
+type tunWaiters struct {
+	mu      sync.Mutex
+	closing bool
+	wg      sync.WaitGroup
+}
+
+func (w *tunWaiters) enter() bool {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closing {
+		return false
+	}
+	w.wg.Add(1)
+	return true
+}
+
+// close lets nobody in any more, wakes those inside and waits for them.
+func (w *tunWaiters) close(wake func() error) {
+	w.mu.Lock()
+	w.closing = true
+	w.mu.Unlock()
+	_ = wake()
+	done := make(chan struct{})
+	go func() {
+		w.wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+	}
 }
 
