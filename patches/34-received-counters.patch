+// countIn counts a packet (hopssh patch 34). Call it after handleHostRoaming.
+func (i *HostInfo) countIn(via ViaSender) {
+	if via.IsRelayed {
+		i.inRelayed.Add(1)
+	} else if via.UdpAddr == i.remote {
+		i.inDirect.Add(1)
+	}
