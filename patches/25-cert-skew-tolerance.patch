-	return c.details.notBefore.After(t) || c.details.notAfter.Before(t)
+	// hopssh patch 25: ClockSkewTolerance widens the window on both ends.
+	return c.details.notBefore.Add(-ClockSkewTolerance).After(t) || c.details.notAfter.Add(ClockSkewTolerance).Before(t)
 }
 
