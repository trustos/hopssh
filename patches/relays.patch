diff --git a/github.com/slackhq/nebula/remote_list_relays_race_test.go b/github.com/slackhq/nebula/remote_list_relays_race_test.go
new file mode 100644
index 0000000..b435c50
--- /dev/null
+++ b/github.com/slackhq/nebula/remote_list_relays_race_test.go
@@ -0,0 +1,36 @@
+package nebula
+
+import (
+	"net/netip"
+	"sync"
+	"testing"
+)
+
+// hopssh patch 38: the handshake goroutine read a peer's relay list while Control
+// (status, the path loop) sorted it in place. Run with -race.
+func TestRelayListIsSafeToRead(t *testing.T) {
+	vpn := netip.MustParseAddr("10.0.0.2")
+	relay := netip.MustParseAddr("10.0.0.1")
+	r := NewRemoteList([]netip.Addr{vpn}, nil)
+	r.Lock()
+	r.unlockedSetRelay(vpn, []netip.Addr{relay})
+	r.Unlock()
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for range 20000 {
+			r.Lock()
+			r.shouldRebuild = true
+			r.Unlock()
+			r.CopyAddrs(nil)
+		}
+	}()
+	for range 20000 {
+		if got := r.copyRelays(); len(got) > 1 || (len(got) == 1 && got[0] != relay) {
+			t.Fatalf("read %v, want nothing or %s", got, relay)
+		}
+	}
+	wg.Wait()
+}
