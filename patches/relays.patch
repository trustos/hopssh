+// copyRelays is the relay list as it is now (hopssh patch 38). Rebuild sorts
+// r.relays in place, so it must not be read without the lock.
+func (r *RemoteList) copyRelays() []netip.Addr {
+	r.RLock()
+	defer r.RUnlock()
+	return slices.Clone(r.relays)
+}
